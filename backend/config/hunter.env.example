# Hunter System configuration TEMPLATE (no secrets).
#
# The real file is   C:\xampp\hunter-system-private\hunter.env
# (outside the web root; override the folder with the HUNTER_PRIVATE_DIR
# environment variable). backend/bin/setup-db-account.php creates it and fills
# DB_USER, DB_PASSWORD and THROTTLE_KEY; never commit the real file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hunter_system_dev
DB_USER=hunter_app
DB_PASSWORD=<generated by setup-db-account.php>

# 64 hex characters (32 random bytes): HMAC key for login-throttle hashes.
THROTTLE_KEY=<generated by setup-db-account.php>

# URL prefix of the project and the Origins allowed to send state-changing requests.
APP_BASE_PATH=/hunter-system
APP_ORIGINS=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1

# Session cookie Secure flag: auto (only on HTTPS requests), true, or false.
COOKIE_SECURE=auto

# Optional throttling overrides (defaults shown).
# THROTTLE_EMAIL_MAX_FAILURES=5
# THROTTLE_IP_MAX_FAILURES=30
# THROTTLE_WINDOW_SECONDS=900
# THROTTLE_LOCK_SECONDS=900
# THROTTLE_RETENTION_SECONDS=86400
